NODE_ENV=development
PORT=3001

# Hardhat local node (default). Change to Base Sepolia RPC for testnet.
HARDHAT_NODE_URL=http://127.0.0.1:8545

# Default Hardhat account #0 private key — ONLY safe on local testnet.
# Replace with a real funded key when deploying to Base Sepolia.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Path to the SQLite database file
DB_PATH=./parcels.db

# Optional: Base Sepolia RPC URL (required only for testnet deployment)
# BASE_SEPOLIA_URL=https://sepolia.base.org
