NODE_ENV=development
PORT=3001

# ─── Local development (default) ──────────────────────────────────────────────
# Hardhat node must be running: cd contracts && npm run node
HARDHAT_NODE_URL=http://127.0.0.1:8545

# Default Hardhat account #0 key — safe ONLY on local testnet. Never use in prod.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: override the SQLite database path
# DB_PATH=./parcels.db


# ─── Base Sepolia testnet deployment ──────────────────────────────────────────
# Run ./deploy-basesepolia.sh from the project root — it handles everything.
# After deploying, set these in Vercel: Settings → Environment Variables.
#
# 1. Generate a new wallet (MetaMask or `cast wallet new` via Foundry)
# 2. Fund it with testnet ETH:
#      https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
#      https://docs.base.org/docs/tools/network-faucets/
# 3. Uncomment and fill in below, then run deploy-basesepolia.sh
#
# HARDHAT_NODE_URL=https://sepolia.base.org
# DEPLOYER_PRIVATE_KEY=0xYOUR_FUNDED_TESTNET_PRIVATE_KEY
# BASE_SEPOLIA_URL=https://sepolia.base.org
